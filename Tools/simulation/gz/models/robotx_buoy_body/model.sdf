<?xml version="1.0" ?>
<sdf version="1.9">
  <!--
    RobotX RoboBuoy body (no beacon). Dimensions from uav_ws/lateral_dim.png and base_dim.png:
      side panels   trapezoids 17 in bottom, 7.25 in top, 12 in high -> square frustum
                    (meshes/robotx_buoy_frustum.stl), off-white
      diamonds      black, side 5.5 in (estimated from united.png), one per panel
      base frame    3/4 in PVC (OD 1.05 in), 15.25 in square + 2 inner bars
      float         pool noodle, diameter 2.5 in (estimated), around the panel bottom edge
    Origin at the bottom of the panels (water surface); panel top at z = 0.3048 m.
    The robotx_buoy_<color> models include this body and put the beacon on top.
  -->
  <model name="robotx_buoy_body">
    <static>true</static>
    <link name="body_link">
      <visual name="panels_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://robotx_buoy_body/meshes/robotx_buoy_frustum.stl</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.9 0.88 0.82 1</ambient>
          <diffuse>0.9 0.88 0.82 1</diffuse>
        </material>
      </visual>
      <visual name="diamond_0_visual">
