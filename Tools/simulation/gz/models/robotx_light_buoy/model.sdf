<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="robotx_light_buoy">
    <static>true</static>

    <link name="base_link">

      <!-- Cuerpo principal: cilindro blanco -->
      <visual name="buoy_body_visual">
        <pose>0 0 0.35 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.2</radius>
            <length>0.7</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
        </material>
      </visual>

      <collision name="buoy_body_collision">
        <pose>0 0 0.35 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.2</radius>
            <length>0.7</length>
          </cylinder>
        </geometry>
      </collision>

      <!-- Base negra achatada del beacon -->
      <visual name="beacon_base_visual">
        <pose>0 0 0.72 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.09</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0 0 0 1</ambient>
          <diffuse>0 0 0 1</diffuse>
        </material>
      </visual>

      <!--
        Domo del beacon: esfera emissive estática.
        Indica la posición/color del beacon visualmente.
        La luz real es creada/eliminada dinámicamente por el plugin.
      -->
      <visual name="beacon_dome_visual">
        <pose>0 0 0.80 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.07</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0 0 1 1</ambient>
          <diffuse>0 0 1 1</diffuse>
          <emissive>0 0 0.5 1</emissive>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>

      <!--
        NO hay <light> estático aquí.
        El plugin crea/elimina la entidad luz dinámicamente
        con CreateEntity() + RequestRemoveEntity().
      -->

    </link>

    <plugin
      filename="gz-sim-robotx-light-buoy-system"
      name="robotx::RobotXLightBuoySystem">
      <!-- color: blue | red | green -->
      <color>blue</color>
      <!-- mode: solid | flashing -->
      <mode>flashing</mode>
      <!-- blink_period en segundos -->
      <blink_period>1.0</blink_period>
    </plugin>

  </model>
</sdf>
