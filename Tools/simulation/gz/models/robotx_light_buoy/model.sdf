<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="robotx_light_buoy">
    <static>true</static>

    <link name="base_link">

      <!-- Cuerpo principal: cilindro blanco -->
      <visual name="buoy_body_visual">
        <pose>0 0 0.35 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.2</radius>
            <length>0.7</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
        </material>
      </visual>

      <collision name="buoy_body_collision">
        <pose>0 0 0.35 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.2</radius>
            <length>0.7</length>
          </cylinder>
        </geometry>
      </collision>

      <!-- Base negra achatada del beacon -->
      <visual name="beacon_base_visual">
        <pose>0 0 0.72 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.09</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0 0 0 1</ambient>
          <diffuse>0 0 0 1</diffuse>
        </material>
      </visual>

      <!--
        Domo del beacon — estado ON (visible por defecto)
        El plugin la mueve a z=-10000 cuando está OFF.
      -->
      <visual name="beacon_dome_on_visual">
        <pose>0 0 0.80 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.07</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0 0 1 1</ambient>
          <diffuse>0 0 1 1</diffuse>
          <emissive>0 0 1 1</emissive>
          <specular>0.05 0.05 0.1 1</specular>
        </material>
      </visual>

      <!--
        Domo del beacon — estado OFF (apagado, oscuro)
        El plugin lo mueve a la posición real cuando la luz está OFF.
        Empieza a z=-10000 (oculto).
      -->
      <visual name="beacon_dome_off_visual">
        <pose>0 0 -10000 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.07</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
          <emissive>0 0 0 1</emissive>
          <specular>0.01 0.01 0.01 1</specular>
        </material>
      </visual>

      <!--
        Luz real del beacon.
        Empieza en la posición activa del beacon.
        El plugin la mueve a z=-10000 para "apagarla"
        sin eliminar/recrear la entidad (evita el flash negro).
        visualize=false suprime el helper verde de Gazebo.
      -->
      <light name="beacon_light" type="point">
        <pose>0 0 0.85 0 0 0</pose>
        <diffuse>0 0 1 1</diffuse>
        <specular>0 0 0.5 1</specular>
        <intensity>1.5</intensity>
        <attenuation>
          <range>10</range>
          <constant>0.5</constant>
          <linear>0.05</linear>
          <quadratic>0.01</quadratic>
        </attenuation>
        <cast_shadows>false</cast_shadows>
        <visualize>false</visualize>
      </light>

    </link>

    <plugin
      filename="gz-sim-robotx-light-buoy-system"
      name="robotx::RobotXLightBuoySystem">
      <!-- color: blue | red | green -->
      <color>blue</color>
      <!-- mode: solid | flashing -->
      <mode>flashing</mode>
      <!-- blink_period en segundos -->
      <blink_period>1.0</blink_period>
    </plugin>

  </model>
</sdf>
